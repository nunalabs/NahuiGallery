# NahuiGallery Frontend Environment Variables

# App Configuration
NEXT_PUBLIC_APP_NAME=NahuiGallery
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ANDE Network Configuration
NEXT_PUBLIC_ANDE_RPC_URL=https://rpc.testnet.ande.network
NEXT_PUBLIC_ANDE_CHAIN_ID=1234
NEXT_PUBLIC_ANDE_CHAIN_NAME=ANDE Testnet
NEXT_PUBLIC_ANDE_EXPLORER=https://testnet.explorer.ande.network

# Smart Contract Addresses (deployed from contracts/deployments/)
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x...

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key
NEXT_PUBLIC_PINATA_SECRET_KEY=your_pinata_secret

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=
