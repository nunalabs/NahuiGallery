# ================================
# NahuiGallery Environment Variables
# ================================

# --------------------------------
# General Configuration
# --------------------------------
NODE_ENV=development
APP_NAME=NahuiGallery
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --------------------------------
# Blockchain Configuration
# --------------------------------
# ANDE Network
ANDE_NETWORK_RPC_URL=https://rpc.ande.network
ANDE_NETWORK_CHAIN_ID=1234
ANDE_NETWORK_EXPLORER=https://explorer.ande.network

# Contract Addresses (deployed)
NFT_FACTORY_ADDRESS=0x...
MARKETPLACE_ADDRESS=0x...
AUCTION_ADDRESS=0x...
REGISTRY_ADDRESS=0x...

# Deployer Private Key (NEVER commit real keys!)
DEPLOYER_PRIVATE_KEY=0x...

# --------------------------------
# Frontend Configuration
# --------------------------------
NEXT_PUBLIC_APP_NAME=NahuiGallery
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# --------------------------------
# Backend Configuration
# --------------------------------

# API Configuration
API_PORT=4000
API_PREFIX=/api/v1
API_RATE_LIMIT=100

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true

# --------------------------------
# Database Configuration
# --------------------------------

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nahui_gallery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nahui_gallery

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --------------------------------
# Message Queue Configuration
# --------------------------------

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=nahui.events
RABBITMQ_QUEUE_PREFIX=nahui

# Kafka (alternative)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nahui-gallery
KAFKA_GROUP_ID=nahui-consumer-group

# --------------------------------
# Storage Configuration
# --------------------------------

# IPFS / Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt

# NFT.Storage
NFT_STORAGE_API_KEY=your_nft_storage_key

# AWS S3 (backup/cache)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nahui-gallery
AWS_REGION=us-east-1

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# --------------------------------
# Authentication & Security
# --------------------------------

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRATION=7d

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TWITTER_API_KEY=
TWITTER_API_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session
SESSION_SECRET=your_session_secret_change_in_production

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here

# --------------------------------
# Email Configuration
# --------------------------------

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nahuigallery.art

# SendGrid (alternative)
SENDGRID_API_KEY=

# --------------------------------
# Monitoring & Logging
# --------------------------------

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Datadog
DATADOG_API_KEY=

# LogRocket
LOGROCKET_APP_ID=

# --------------------------------
# External APIs
# --------------------------------

# CoinGecko (price feeds)
COINGECKO_API_KEY=

# Alchemy (blockchain indexing)
ALCHEMY_API_KEY=

# Moralis (NFT data)
MORALIS_API_KEY=

# The Graph (subgraph)
THEGRAPH_API_KEY=

# OpenAI (AI features)
OPENAI_API_KEY=

# --------------------------------
# Platform Configuration
# --------------------------------

# Fees (in basis points)
PLATFORM_FEE=250
PLATFORM_FEE_RECIPIENT=0x...

# Limits
MAX_FILE_SIZE=100MB
MAX_COLLECTION_SIZE=10000
MIN_MINT_PRICE=0.001

# --------------------------------
# Development Tools
# --------------------------------

# Hardhat
HARDHAT_NETWORK=localhost
REPORT_GAS=true
COINMARKETCAP_API_KEY=

# Foundry
FOUNDRY_PROFILE=default

# --------------------------------
# Feature Flags
# --------------------------------

FEATURE_AUCTION=true
FEATURE_COLLECTIONS=true
FEATURE_ANALYTICS=true
FEATURE_SOCIAL=true
FEATURE_CUSTODIAL_WALLET=false
